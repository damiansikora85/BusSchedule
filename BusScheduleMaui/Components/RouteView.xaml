<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="BusSchedule.Components.RouteView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModel="clr-namespace:BusSchedule.Components.ViewModels;assembly=BusSchedule.Core.UI"
    x:DataType="viewModel:RouteViewModel">
    <ContentView.Content>
        <Border
            Margin="4"
            Padding="8,2"
            BackgroundColor="{Binding RouteColor}"
            StrokeShape="RoundRectangle 5">
            <Border.Shadow>
                <Shadow
                    Brush="Black"
                    Opacity="0.5"
                    Radius="6"
                    Offset="4,4" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
            </Border.GestureRecognizers>
            <Label
                FontAttributes="Bold"
                FontSize="36"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Text="{Binding Name}"
                TextColor="{Binding RouteTextColor}"
                VerticalOptions="Fill"
                VerticalTextAlignment="Center" />
        </Border>
    </ContentView.Content>
</ContentView>